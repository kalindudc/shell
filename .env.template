# Configuration template
# This file is auto-generated during setup by src/setup.sh (prompt_git_config function)
# Copy this to .env and fill in your values, or run ./install.sh to generate automatically

# --- Git ---
GIT_EMAIL=<git-email>
GIT_NAME="<git-name>"
GIT_SIGNING_KEY=<git-signing-key>

# Optional second identity for repos of the personal GitHub account (see the includeIf in
# src/templates/.gitconfig.erb). Leave empty when it is the same as GIT_EMAIL. A signing key
# for this email is found or generated by ./install.sh and task generate:gitconfig.
GIT_PERSONAL_EMAIL=
GIT_PERSONAL_SIGNING_KEY=
