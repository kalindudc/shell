# Configuration template
# Copy this to .env and fill in your values; ./install.sh reads it, and a variable already set in
# the environment wins. Without GIT_*, git's global user.name, user.email and signingkey are used.
# SHELL_MACHINE_PROFILE=work selects profiles.work in bb.yml.

# --- Git ---
GIT_EMAIL=<git-email>
GIT_NAME="<git-name>"
GIT_SIGNING_KEY=<git-signing-key>
