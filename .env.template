# Configuration template
# Read by `task setup` (src/install/setup.rb), which finds or creates the GPG signing key.
# Copy this to .env and fill in your values. The git identity itself is in nix/user.nix.

# --- Git ---
GIT_EMAIL=<git-email>
GIT_NAME="<git-name>"
GIT_SIGNING_KEY=<git-signing-key>

# GIT_NAME and GIT_EMAIL name the GPG key. Work repos switch to the work identity through
# git/gitconfig in the private repo, which ~/.config/git/config includes last.
