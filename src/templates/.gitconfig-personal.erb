<%
  email = ENV["GIT_PERSONAL_EMAIL"].to_s.strip
  signing_key = ENV["GIT_PERSONAL_SIGNING_KEY"].to_s.strip
%>
# Included by ~/.gitconfig for repos of my personal GitHub account.
[user]
	email = <%= email %>
  <%- if signing_key != "" -%>
	signingkey = <%= signing_key %>
  <%- end -%>
[commit]
  <%- if signing_key != "" -%>
	gpgsign = true
  <%- else -%>
	# without a personal key, signing with the main key would only give an unverified commit
	gpgsign = false
  <%- end -%>
