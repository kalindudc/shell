FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive \
  TZ=America/New_York \
  LANG=C.UTF-8 \
  LC_ALL=C.UTF-8

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && \
  echo $TZ > /etc/timezone

RUN apt-get update && \
  apt-get install -y --no-install-recommends \
  bash \
  ca-certificates \
  git \
  sudo \
  && apt-get clean && \
  rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["/bin/bash"]
