# Tool-installed skills, pi runtime state and credentials live in real directories
# in $HOME, not here (see realDirs in nix/home/dotfiles.nix). The rules below cover
# files written inside directories that are linked into the repo as a whole.

# private interview material must never be committed
home/.agents/**/*interview*
home/.pi/agent/**/*interview*

# SKILL_NOTES.md files are local observations, bootstrapped by src/scripts/bootstrap-skill-notes.sh
home/.agents/skills/*/SKILL_NOTES.md
# impact-review org pack (internal forms, ids, adapters); the generic skill is tracked
home/.agents/skills/impact-review/private/
__pycache__/

# safety net for private keys; ~/.gnupg is a real directory
home/.gnupg/*
!home/.gnupg/gpg-agent.conf

# nix build output
result
result-*
